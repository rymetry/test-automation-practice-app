{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test-automation-practice-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-29",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    // Everything that is not a real file is answered with index.html (client-side routing).
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only these paths reach the Worker; every other path is served straight from the assets.
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }]
}
