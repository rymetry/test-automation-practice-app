{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testing-sandbox",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-29",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    // 実在するファイル以外へのリクエストには index.html を返す（クライアント側ルーティング）。
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Worker に届くのはこれらのパスだけ。ほかのパスはすべてアセットから直接配信する。
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "SessionDO" }]
  },
  // 本番は v3 まで適用済み。PR プレビューは空の状態から全タグを順に適用するため、
  // 同じクラスの削除と再作成（v1 / v2）を残すとプレビューのデプロイが失敗する。
  "migrations": [{ "tag": "v3", "new_sqlite_classes": ["SessionDO"] }],
  // PR プレビューは本番とは別の Durable Object namespace を自動作成して隔離する。
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "SESSIONS", "class_name": "SessionDO" }]
    }
  }
}
